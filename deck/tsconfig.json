{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `node` is here for `vite.config.ts`, which reads the filesystem to keep a
    // stale `public/art/` out of a build. Global type packages are program-wide,
    // so this is visible to `src/` as well; splitting the config into app and
    // build-tool projects would scope it properly and is worth doing if client
    // code ever starts reaching for `process`.
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Never reached while `noEmit` holds, and that is the point: without an
    // `outDir`, a run that loses `noEmit` writes a compiled `.js` next to every
    // one of the sources under `src/`. Naming a throwaway directory means the
    // worst such a run can do is fill a cache that is already ignored.
    "outDir": "node_modules/.cache/tsc",
    // An `outDir` would otherwise take the build log with it; keep it where
    // `.gitignore` and README.md already say it lives.
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true
  },
  "include": ["src", "vite.config.ts", "demo.config.ts"]
}
