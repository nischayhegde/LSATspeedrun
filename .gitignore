# Punch-list scratch (screenshots, harnesses, measurements). Regenerated on demand.
.punch/

# Async-coaching investigation scratch (harnesses, logs, timings).
.async/

# Office-scene scratch (renders, harnesses, measurements, work mirrors).
.office/

# Map-scene scratch (renders, harnesses, measurements, work mirrors).
.maps/

# App-wide performance scratch (harnesses, traces, measurements, work mirrors).
.appperf/

# Character hair/cosmetics scratch (renders, harnesses, comparison sheets).
.cosmetics/

# Merge-reconciliation scratch (upstream patches, scratch databases, gate logs).
.reconcile/

# Mobile/UI verification scratch (screenshot matrices, harnesses, reports).
.shots/

# Perf/QA sweep scratch from the office-and-map work (screenshot matrices,
# A/B reports, probe harnesses, LCP filmstrips, layout measurements). These are
# regenerated on demand. They are listed here because `deploy-sandbox.ps1` runs
# `git add --all` before it commits the release, so anything untracked at deploy
# time is pushed to main and then re-fetched onto the 1 GiB build box.
.cast-shots/
.deck-gif/
.lcp-evidence/
.map-shots/
.office-evidence/
.qa-tmp/
.room-evidence/
.seam-verify/
.shots-keep/
.lcp-notes.md
.map-notes.md
.firm-audit.md
.deploy-preflight.md

# Demo-walkthrough verification scratch (screenshots, harnesses, reports).
.demo-verify/

# Demo autoplay driver scratch: filmstrip captures (738 PNG, 782 MB), timing
# and geometry probes, and the harnesses that drive them. All regenerated on
# demand. Ignored for the `git add --all` reason above: at this size it is the
# worst thing in the tree to hand to the 1 GiB build box. The driver's own
# sources live in frontend/src/demo/ and are deliberately not covered here.
.autoplay/

# Slide-mockup scratch: exported-PDF page renders and the shoot harnesses that
# produced them, used while matching one slide back to the deck. Regenerated on
# demand, and the deck's real sources are in deck/src/.
.deck-slide/

# Alternate build outputs kept while comparing bundles. The QA sweep renames
# these between runs, so match the shapes rather than one fixed name.
frontend/dist-qa*/
.qa-dist/
.qa-dist*/

# Presentation deck. The sources are tracked; the generated and copied
# artefacts below are not. The split is deliberate rather than tidy-minded:
# `deploy-sandbox.ps1` runs `git add --all`, so anything here that is untracked
# but not ignored is pushed to main and re-fetched onto the 1 GiB build box.
deck/node_modules/
deck/dist/
deck/.deck-shots/
deck/tsconfig.tsbuildinfo

# Screenshot-harness scratch from the deck QA sweeps: the probe .mjs files and
# the 25 MB of PNG they render. Regenerated on demand, and ignored for the same
# `git add --all` reason as the block above -- excluding it by hand at commit
# time does not stop the deploy from sweeping it into a release.
deck/.deck-qa/

# `deck/public/art/` is a byte-identical copy of `frontend/public/art/` (218
# .webp, 18 MB), which is already tracked — see `deck/src/app-art/PORT.md`. One
# `cp -R` rebuilds it exactly, and deck/README.md records the command.
#
# `deck/public/stills/` is NOT ignored, despite being 26 MB of PNG. Nothing in
# the repo regenerates it: the route stills were captured by hand against a
# seeded account that no longer exists in that state, and the two office-tier
# stills came from `.shots-keep/`, which is ignored two blocks up. They are the
# deck's on-stage fallback, so losing them costs more than carrying them.
deck/public/art/

# Root-level harness dependencies (playwright, pngjs, gifenc) used by the
# scratch probes above. The application's own manifests live in frontend/.
/package.json
/package-lock.json
