FLASK_ENV=development
SECRET_KEY=change-me-for-any-shared-environment
DATABASE_URL=sqlite:///lsat_sherlock.db
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
# Comma-separated OAuth client IDs for the native iOS/Android builds. The web
# client ID above remains valid for native sign-in as an Expo development fallback.
GOOGLE_MOBILE_CLIENT_IDS=
DEV_AUTH_ENABLED=true
MOBILE_AUTH_DAYS=90
AUTO_SEED=true
ALLOW_UNREVIEWED_QUESTIONS=true
# Questions per mega-litigation (diagnostic). Minimum 6. Defaults to 77 when
# unset, which is the reference form the projected score converts against (two
# Logical Reasoning sections of 25 plus one Reading Comprehension of 27) — keep
# the two equal unless you specifically want a short form, and expect a startup
# warning if you do. DIAGNOSTIC_SIZE is still accepted as the historical alias.
DIAGNOSTIC_SESSION_SIZE=77
# Questions per practice run. Left unset on purpose: the default comes from
# `game.SITTING_QUESTIONS`, which is also what the economy counts contract
# lengths, daily goals and the practice queue cap in, so pinning a number here
# sets the run size without moving any of them. Set it only to deliberately
# diverge from the economy, and expect the daily goals to stop landing on run
# boundaries when you do.
# PRACTICE_SESSION_SIZE=6
PORT=5000
FLASK_DEBUG=false
# TFY_URL must point at an LLM gateway tenant this business holds a billed
# account and signed zero-data-retention DPA for. Every request sends a
# student's full written reasoning; do not point this at a shared/demo tenant
# (e.g. a gateway belonging to an unrelated company) — see
# research/09-privacy-and-compliance.md § 7, risk R1. The app also sends
# `X-TFY-LOGGING-CONFIG: {"enabled": false}` on every request regardless of
# provider, but that header is defense-in-depth, not a substitute for the DPA.
TFY_API_KEY=
TFY_URL=
