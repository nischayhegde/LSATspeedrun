FLASK_ENV=development
SECRET_KEY=change-me-for-any-shared-environment
DATABASE_URL=sqlite:///lsat_sherlock.db
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
# Comma-separated OAuth client IDs for the native iOS/Android builds. The web
# client ID above remains valid for native sign-in as an Expo development fallback.
GOOGLE_MOBILE_CLIENT_IDS=
DEV_AUTH_ENABLED=true
MOBILE_AUTH_DAYS=90
AUTO_SEED=true
ALLOW_UNREVIEWED_QUESTIONS=true
# Questions per mega-litigation (diagnostic). Minimum 6. Defaults to 77 when
# unset, which is the reference form the projected score converts against (two
# Logical Reasoning sections of 25 plus one Reading Comprehension of 27) — keep
# the two equal unless you specifically want a short form, and expect a startup
# warning if you do. DIAGNOSTIC_SIZE is still accepted as the historical alias.
DIAGNOSTIC_SESSION_SIZE=77
PRACTICE_SESSION_SIZE=10
# 5001, not 5000. Both dev servers proxy the API to 127.0.0.1:5001 by default
# (frontend/vite.config.ts, deck/vite.config.ts), and 5000 is reserved by macOS
# Control Center on many machines besides. A backend provisioned from this file
# with PORT=5000 comes up healthy and is simply never reached: the frontend
# shows a login screen that cannot log in, and every demo iframe in the deck
# lands on it. Override LSAT_API_PORT for both dev servers if you move it.
PORT=5001
FLASK_DEBUG=false
# TFY_URL must point at an LLM gateway tenant this business holds a billed
# account and signed zero-data-retention DPA for. Every request sends a
# student's full written reasoning; do not point this at a shared/demo tenant
# (e.g. a gateway belonging to an unrelated company) — see
# research/09-privacy-and-compliance.md § 7, risk R1. The app also sends
# `X-TFY-LOGGING-CONFIG: {"enabled": false}` on every request regardless of
# provider, but that header is defense-in-depth, not a substitute for the DPA.
TFY_API_KEY=
TFY_URL=
# The narrative generator's gateway, kept separate from the coaching one above
# so the two can point at different tenants and be rotated independently.
#
# Nothing in this tree reads these three yet — `create_app` does not name them
# and neither does anything under `backend/app/`. They are here because the
# working `.env` carries them and an example file that omits half of a real
# environment is how a provisioned machine ends up subtly different from the
# one it was copied from: someone diffs the two, finds three keys they cannot
# account for, and guesses. Empty is the correct value until the code that
# reads them lands; it is not a value to fill in speculatively.
#
# Same handling as TFY_* when they do become live: a billed tenant under a
# signed zero-data-retention DPA, never a shared or demo gateway. Leave the
# values empty in this file. Real credentials belong in `.env`, which is
# git-ignored and must stay that way.
STORY_LLM_BASE_URL=
STORY_LLM_API_KEY=
STORY_LLM_MODEL=
