FLASK_ENV=development
SECRET_KEY=change-me-for-any-shared-environment
DATABASE_URL=sqlite:///lsat_sherlock.db
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
# Comma-separated OAuth client IDs for the native iOS/Android builds. The web
# client ID above remains valid for native sign-in as an Expo development fallback.
GOOGLE_MOBILE_CLIENT_IDS=
DEV_AUTH_ENABLED=true
MOBILE_AUTH_DAYS=90
AUTO_SEED=true
ALLOW_UNREVIEWED_QUESTIONS=true
DIAGNOSTIC_SIZE=35
PORT=5000
FLASK_DEBUG=false
TFY_API_KEY=
TFY_URL=
