FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@database-host:5432/lsat_sherlock
FRONTEND_ORIGIN=https://app.example.com
GOOGLE_CLIENT_ID=your-production-client-id.apps.googleusercontent.com
GOOGLE_MOBILE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
MOBILE_AUTH_DAYS=90
DEV_AUTH_ENABLED=false
AUTO_SEED=false
ALLOW_UNREVIEWED_QUESTIONS=false
# Questions per mega-litigation (diagnostic). Minimum 6. Defaults to 77 when
# unset, which is the reference form the projected score converts against (two
# Logical Reasoning sections of 25 plus one Reading Comprehension of 27) — keep
# the two equal unless you specifically want a short form, and expect a startup
# warning if you do. DIAGNOSTIC_SIZE is still accepted as the historical alias.
DIAGNOSTIC_SESSION_SIZE=77
PORT=5000
FLASK_DEBUG=false
# See backend/.env.example for the subprocessor/DPA requirement on this value.
TFY_API_KEY=
TFY_URL=
