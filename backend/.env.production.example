FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@database-host:5432/lsat_sherlock
FRONTEND_ORIGIN=https://app.example.com
GOOGLE_CLIENT_ID=your-production-client-id.apps.googleusercontent.com
GOOGLE_MOBILE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
MOBILE_AUTH_DAYS=90
DEV_AUTH_ENABLED=false
AUTO_SEED=false
ALLOW_UNREVIEWED_QUESTIONS=false
DIAGNOSTIC_SIZE=35
PORT=5000
FLASK_DEBUG=false
TFY_API_KEY=
TFY_URL=
